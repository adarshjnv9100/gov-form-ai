# ============================================================
# ENVIRONMENT VARIABLES — AI GOVERNMENT FORM AUTO-FILL SYSTEM
# Copy this file to .env.local and fill in your values.
# ============================================================

# ── Backend NVIDIA API (Server-Side Only) ────────────────────
# Read by Vercel serverless functions (api/ocr.ts, api/nemotron.ts).
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ── Supabase Database (Server-Side) ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase Database (Frontend Client) ──────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Cloudinary Storage (Server-Side) ─────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Cloudinary Storage (Frontend Vite Client) ────────────────
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=government-form-ai

# ── Site URL Configuration ───────────────────────────────────
VITE_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
