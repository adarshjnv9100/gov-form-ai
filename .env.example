# ============================================================
# ENVIRONMENT VARIABLES — GOV FORM AI
# Copy this file to .env.local and fill in your values.
# ============================================================

# ── Supabase (client-side) ───────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Cloudinary (client-side upload) ──────────────────────────
# Used for unsigned uploads from the browser.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ── NVIDIA API Key (SERVER-SIDE ONLY) ────────────────────────
# THIS KEY MUST NEVER HAVE THE VITE_ PREFIX.
# It is only read by Vercel serverless functions (api/ocr.ts, api/nemotron.ts).
# Set this in Vercel Dashboard → Settings → Environment Variables.
# For local development with `vercel dev`, add it to .env.local WITHOUT VITE_ prefix.
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# ── Site URL (optional) ───────────────────────────────────────
VITE_SITE_URL=https://your-app.vercel.app
